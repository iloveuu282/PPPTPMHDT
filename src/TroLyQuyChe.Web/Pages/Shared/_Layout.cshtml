@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#315d7d" />
    <title>@ViewData["Title"] · Trợ lý quy chế</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#noi-dung">Đến nội dung chính</a>
    <svg class="icon-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <symbol id="i-book" viewBox="0 0 24 24"><path d="M12 5v16m0-16C8 2 4 3 2 4v15c3-1 7-1 10 2 3-3 7-3 10-2V4c-2-1-6-2-10 1Z" /></symbol>
        <symbol id="i-chat" viewBox="0 0 24 24"><path d="M21 11a9 9 0 0 1-9 9H4l-3 2 2-6a9 9 0 1 1 18-5Z" /><path d="M7 10h10M7 14h6" /></symbol>
        <symbol id="i-history" viewBox="0 0 24 24"><path d="M3 4v5h5M3 9a9 9 0 1 1 0 6m9-9v6l4 2" /></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6" /></symbol>
        <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M7 3v4m10-4v4M3 11h18m-13 5h3" /></symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></symbol>
        <symbol id="i-external" viewBox="0 0 24 24"><path d="M14 3h7v7m0-7L10 14m-1-9H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4" /></symbol>
    </svg>
    <header class="site-header">
        <nav class="shell site-nav" aria-label="Điều hướng chính">
            <a class="brand" asp-page="/Index"><span class="logo" aria-hidden="true"><svg class="icon" aria-hidden="true"><use href="#i-book" /></svg></span><span>Trợ lý quy chế<small>@IdentityOptions.Value.UpperName · NỘI BỘ</small></span></a>
            <div class="nav-links">
                <a class="@(currentPage == "/Index" ? "active" : "")" asp-page="/Index" aria-current="@(currentPage == "/Index" ? "page" : null)">Hỏi đáp</a>
                <a asp-page="/Policies">Bộ quy chế</a>
                <a class="@(currentPage.StartsWith("/Admin") ? "active" : "")" asp-page="/Admin/Index" aria-current="@(currentPage.StartsWith("/Admin") ? "page" : null)">Quản trị</a>
                @if (User.IsInRole("Admin"))
                {
                    <form method="post" asp-page="/Account/Logout"><button class="nav-account" title="Đăng xuất @User.Identity?.Name">Đăng xuất</button></form>
                }
                else { <a class="nav-account login-link" asp-page="/Account/Login">Đăng nhập <small>(dành riêng cho quản trị viên)</small></a> }
            </div>
        </nav>
    </header>
    <main id="noi-dung" class="shell main-content">@RenderBody()</main>
    <footer class="shell site-footer"><span class="demo-label">DỮ LIỆU MÔ PHỎNG</span><span>@IdentityOptions.Value.OrganizationName</span></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
