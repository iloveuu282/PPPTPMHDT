        <mxCell id="c31" parent="1" value="PolicyLookupService: lọc bản bao phủ kỳ, Topic và cận ngày nghỉ. Không có nguồn → thiếu căn cứ; kỳ đổi bản → hỏi lại." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#273747;strokeColor=#526577;strokeWidth=1.5;shadow=0;shape=note;size=16;fillColor=#fffdf5;align=left;verticalAlign=top;spacing=14;fontSize=17;">
