        <mxCell id="c35" parent="1" value="Tạo QaEntry + ProcessingTraceJson. Chỉ khi Answered mới thêm Citations; các kết quả cần làm rõ/thiếu căn cứ vẫn được lưu." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#273747;strokeColor=#526577;strokeWidth=1.5;shadow=0;shape=note;size=16;fillColor=#fffdf5;align=left;verticalAlign=top;spacing=14;fontSize=18;">
