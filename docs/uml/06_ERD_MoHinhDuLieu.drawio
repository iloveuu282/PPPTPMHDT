        </mxCell>
        <mxCell id="c47" parent="1" value="Khóa và ràng buộc&lt;br/&gt;PK: khóa chính; FK: khóa ngoại; UQ: duy nhất.&lt;br/&gt;ReplacesVersionId có unique index lọc IS NOT NULL: mỗi bản có tối đa một bản kế tiếp.&lt;br/&gt;CK_Version_Dates: EffectiveTo rỗng hoặc không trước EffectiveFrom.&lt;br/&gt;Khóa ngoại dùng Restrict, bảo toàn nguồn đang được tham chiếu." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#273747;strokeColor=#526577;strokeWidth=1.5;shadow=0;shape=note;size=16;fillColor=#fffdf5;align=left;verticalAlign=top;spacing=14;fontSize=19;">
          <mxGeometry x="50" y="1130" width="880" height="225" as="geometry" />
        </mxCell>
        <mxCell id="c48" parent="1" value="Không phải cột SQL&lt;br/&gt;ApplicableUntil và ReplacedOnStartDate được tính trong C#.&lt;br/&gt;OwnerId không phải FK đến AppUsers.&lt;br/&gt;__EFMigrationsHistory là bảng hệ thống EF Core, không nằm trong bảy bảng nghiệp vụ." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#273747;strokeColor=#526577;strokeWidth=1.5;shadow=0;shape=note;size=16;fillColor=#fffdf5;align=left;verticalAlign=top;spacing=14;fontSize=19;">
          <mxGeometry x="50" y="1390" width="880" height="175" as="geometry" />
        </mxCell>
        <mxCell id="c49" parent="1" value="Chỉ mục lịch sử: QaEntries(OwnerId, AskedAt). Các cột không ghi NULL là NOT NULL.&lt;br/&gt;Trigger bảo vệ nguồn đã duyệt/thu hồi; RowVersion dùng phát hiện thay đổi đồng thời." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#273747;strokeColor=#526577;strokeWidth=1.5;shadow=0;shape=text;fillColor=none;strokeColor=none;fontSize=18;fontColor=#273747;fontStyle=0;align=left;verticalAlign=middle;spacing=2;">
          <mxGeometry x="50" y="1580" width="1430" height="45" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>