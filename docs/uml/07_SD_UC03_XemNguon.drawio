        <mxCell id="c16" parent="1" value="SourceModel lấy OwnerId bằng BrowserOwner.GetAsync và quyền User.IsInRole(&amp;quot;Admin&amp;quot;). Không yêu cầu người tra cứu phải đăng nhập quản trị." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#273747;strokeColor=#526577;strokeWidth=1.5;shadow=0;shape=note;size=16;fillColor=#fffdf5;align=left;verticalAlign=top;spacing=14;fontSize=18;">
