        </mxCell>
        <mxCell id="c27" parent="1" value="CheckDraft + RowVersion; chọn ngày duyệt hoặc ngày đã lưu.&lt;br/&gt;Kiểm ngày, điều khoản, NoticeProblem, MissingTopics và phiên bản chồng hiệu lực.&lt;br/&gt;Đọc các bản liên quan qua db; chủ đề bị bỏ phải được xác nhận." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#273747;strokeColor=#526577;strokeWidth=1.5;shadow=0;shape=note;size=16;fillColor=#fffdf5;align=left;verticalAlign=top;spacing=14;fontSize=18;">
