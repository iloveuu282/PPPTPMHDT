        </mxCell>
        <mxCell id="c31" parent="1" value="Nếu thay thế: gán ReplacesVersionId và ghi Superseded cho bản trước.&lt;br/&gt;Gán ApprovedAt, Status=Approved và nhật ký Approved cho bản mới.&lt;br/&gt;Không UPDATE nội dung hoặc ngày gốc của nguồn trước." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#273747;strokeColor=#526577;strokeWidth=1.5;shadow=0;shape=note;size=16;fillColor=#fffdf5;align=left;verticalAlign=top;spacing=14;fontSize=18;">
