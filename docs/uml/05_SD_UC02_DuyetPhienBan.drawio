          </mxGeometry>
        </mxCell>
        <mxCell id="c39" parent="1" value="Thành công: TempData “đã ghi nhật ký” → redirect GET trang sửa.&lt;br/&gt;Thu hồi dùng RevokeAsync: kiểm quyền, RowVersion, Approved và lý do; cập nhật Revoked + nhật ký trong giao dịch tương tự." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#273747;strokeColor=#526577;strokeWidth=1.5;shadow=0;shape=text;fillColor=none;strokeColor=none;fontSize=18;fontColor=#273747;fontStyle=0;align=center;verticalAlign=middle;spacing=2;">
