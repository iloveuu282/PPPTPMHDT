        </mxCell>
        <mxCell id="c16" parent="1" value="Hiệu lực tính toán&lt;br/&gt;• Chưa đến ngày áp dụng.&lt;br/&gt;• Đang áp dụng.&lt;br/&gt;• Hết khoảng áp dụng.&lt;br/&gt;Đây không phải các giá trị mới của VersionStatus." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#273747;strokeColor=#526577;strokeWidth=1.5;shadow=0;shape=note;size=16;fillColor=#fffdf5;align=left;verticalAlign=top;spacing=14;fontSize=19;">
          <mxGeometry x="960" y="665" width="350" height="240" as="geometry" />
        </mxCell>
        <mxCell id="c17" parent="1" value="Thay thế&lt;br/&gt;Bản mới giữ ReplacesVersionId trỏ về bản trước.&lt;br/&gt;Bản trước vẫn Approved; không sửa ngày gốc.&lt;br/&gt;Cùng ngày: nguồn trước giữ cho lịch sử, câu mới dùng bản sau." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#273747;strokeColor=#526577;strokeWidth=1.5;shadow=0;shape=note;size=16;fillColor=#fffdf5;align=left;verticalAlign=top;spacing=14;fontSize=19;">
          <mxGeometry x="35" y="665" width="350" height="285" as="geometry" />
        </mxCell>
        <mxCell id="c18" parent="1" value="Thu hồi bản kế tiếp không tự phục hồi bản trước. Không có thao tác xóa nguồn hoặc chuyển Revoked trở lại Approved trong chức năng quản trị hiện tại." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#273747;strokeColor=#526577;strokeWidth=1.5;shadow=0;shape=note;size=16;fillColor=#fffdf5;align=left;verticalAlign=top;spacing=14;fontSize=18;">
