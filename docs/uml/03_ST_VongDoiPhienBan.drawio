        <mxCell id="c15" parent="1" value="Khi duyệt&lt;br/&gt;Kiểm điều khoản, cận báo trước, chủ đề thiếu và khoảng hiệu lực.&lt;br/&gt;Mặc định có thể dùng ngày duyệt theo giờ Việt Nam.&lt;br/&gt;Lỗi kiểm tra: không chuyển trạng thái." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#273747;strokeColor=#526577;strokeWidth=1.5;shadow=0;shape=note;size=16;fillColor=#fffdf5;align=left;verticalAlign=top;spacing=14;fontSize=19;">
